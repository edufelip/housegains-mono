# HouseGains mobile environment template.
# Copy to .env and fill in only what you need. .env is gitignored; never commit real values.
# Every value below is optional. Leave a value empty to use the code default.

# Build variant: "dev" (default when unset) or "prod".
APP_VARIANT=

# Terms gate (defaults: version "v1", HouseGains terms and privacy URLs).
EXPO_PUBLIC_TERMS_REQUIRED_VERSION=
EXPO_PUBLIC_TERMS_URL=
EXPO_PUBLIC_PRIVACY_POLICY_URL=

# Use the local Firebase emulators in __DEV__ builds. Set to 1 to enable.
EXPO_PUBLIC_USE_FIREBASE_EMULATORS=

# Google sign-in. Public OAuth client IDs, not secrets.
EXPO_PUBLIC_GOOGLE_OAUTH_IOS_CLIENT_ID=your-ios-client-id.apps.googleusercontent.com
EXPO_PUBLIC_GOOGLE_OAUTH_ANDROID_CLIENT_ID=your-android-client-id.apps.googleusercontent.com
EXPO_PUBLIC_GOOGLE_OAUTH_WEB_CLIENT_ID=your-web-client-id.apps.googleusercontent.com

# Sign in with Apple on the web (browser flow only). Public identifiers.
EXPO_PUBLIC_APPLE_WEB_CLIENT_ID=
EXPO_PUBLIC_APPLE_WEB_REDIRECT_URI=
