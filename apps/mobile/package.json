{
  "name": "housegains-mobile",
  "main": "expo-router/entry",
  "version": "1.0.0",
  "packageManager": "bun@1.3.14",
  "scripts": {
    "start": "expo start",
    "android": "expo run:android",
    "android:dev": "EXPO_PUBLIC_ENV=dev APP_VARIANT=dev expo run:android --variant devDebug --app-id com.housegains.app.dev",
    "android:prod": "EXPO_PUBLIC_ENV=dev APP_VARIANT=prod expo run:android --variant productionDebug",
    "android:release": "EXPO_PUBLIC_ENV=prod APP_VARIANT=prod EXPO_NO_DEV_CLIENT=1 ./android/gradlew -p android app:assembleProductionRelease -PCI_VERSION_CODE=${CI_VERSION_CODE:?CI_VERSION_CODE_required} -x lint -x test --configure-on-demand --build-cache",
    "android:release:device": "EXPO_PUBLIC_ENV=prod APP_VARIANT=prod EXPO_NO_DEV_CLIENT=1 ./android/gradlew -p android app:assembleProductionRelease -PlocalReleaseInstall=true -PCI_VERSION_CODE=${CI_VERSION_CODE:?CI_VERSION_CODE_required} -x lint -x test --configure-on-demand --build-cache && adb install -r android/app/build/outputs/apk/production/release/app-production-release.apk",
    "ios": "expo run:ios",
    "ios:dev": "EXPO_PUBLIC_ENV=dev APP_VARIANT=dev expo run:ios --scheme HouseGains",
    "ios:prod": "EXPO_PUBLIC_ENV=prod APP_VARIANT=prod expo run:ios --scheme HouseGains",
    "ios:release": "EXPO_PUBLIC_ENV=prod APP_VARIANT=prod EXPO_NO_DEV_CLIENT=1 expo run:ios --scheme HouseGains --configuration Release",
    "web": "expo start --web",
    "web:dev": "expo start --web",
    "web:export": "expo export --platform web --output-dir dist/web",
    "lint": "eslint housegains-app app features components tests scripts --cache --cache-location .expo/cache/eslint/",
    "lint:ci": "oxlint housegains-app app features components tests scripts",
    "typecheck": "tsc --noEmit",
    "format": "prettier --write \"app/**/*.{ts,tsx}\" \"features/**/*.{ts,tsx}\" \"scripts/**/*.{js,mjs,ts}\" \"tests/**/*.{js,mjs,ts,tsx}\" \"*.{js,mjs,json,ts}\"",
    "format:check": "prettier --check \"app/**/*.{ts,tsx}\" \"features/**/*.{ts,tsx}\" \"scripts/**/*.{js,mjs,ts}\" \"tests/**/*.{js,mjs,ts,tsx}\" \"*.{js,mjs,json,ts}\"",
    "prepare": "cd ../.. && husky apps/mobile/.husky",
    "test": "bun run test:unit",
    "test:unit": "bun test housegains-config.test.ts features localization",
    "test:all": "bun run test:unit && bun run test:component",
    "test:e2e:build:ios:debug": "xcodebuild -workspace ios/HouseGains.xcworkspace -scheme HouseGains -configuration Debug -sdk iphonesimulator -derivedDataPath ios/build RCT_METRO_PORT=${NATIVE_METRO_PORT:-8081}",
    "test:e2e:build:android:debug": "cd android && APP_VARIANT=dev EXPO_PUBLIC_ENV=dev ./gradlew app:assembleDevDebug -PreactNativeDevServerPort=${NATIVE_METRO_PORT:-8081}",
    "test:component": "jest --config jest.component.config.cjs"
  },
  "dependencies": {
    "@babel/runtime": "^7.20.0",
    "@expo-google-fonts/geist": "0.4.2",
    "@expo-google-fonts/geist-mono": "0.4.3",
    "@expo/vector-icons": "^15.0.3",
    "@react-native-async-storage/async-storage": "2.2.0",
    "@react-native-community/netinfo": "11.4.1",
    "@react-native-firebase/app": "23.8.8",
    "@react-native-firebase/auth": "23.8.8",
    "@react-native-firebase/crashlytics": "23.8.8",
    "@react-native-firebase/firestore": "23.8.8",
    "@react-native-firebase/functions": "23.8.8",
    "@react-native-firebase/messaging": "23.8.8",
    "@react-native-firebase/remote-config": "23.8.8",
    "@react-native-google-signin/google-signin": "16.1.2",
    "expo": "~54.0.33",
    "expo-apple-authentication": "~8.0.8",
    "expo-camera": "~17.0.10",
    "expo-clipboard": "~8.0.8",
    "expo-constants": "~18.0.13",
    "expo-crypto": "~15.0.8",
    "expo-font": "~14.0.11",
    "expo-linking": "~8.0.11",
    "expo-localization": "~17.0.8",
    "expo-router": "~6.0.23",
    "expo-splash-screen": "~31.0.13",
    "expo-status-bar": "~3.0.9",
    "expo-store-review": "~9.0.9",
    "react": "19.1.0",
    "react-dom": "19.1.0",
    "react-native": "0.81.5",
    "react-native-gesture-handler": "~2.28.0",
    "react-native-reanimated": "~4.1.1",
    "react-native-safe-area-context": "~5.6.0",
    "react-native-screens": "~4.16.0",
    "react-native-svg": "15.12.1",
    "react-native-web": "~0.21.0",
    "react-native-worklets": "0.5.1"
  },
  "devDependencies": {
    "@testing-library/react-native": "14.0.1",
    "@types/jest": "^29.5.14",
    "@types/node": "^26.6.6",
    "@types/react": "~19.1.0",
    "@typescript-eslint/eslint-plugin": "^8.66.0",
    "@typescript-eslint/parser": "^8.66.0",
    "babel-preset-expo": "~54.0.10",
    "eslint": "^9.25.0",
    "eslint-config-expo": "~10.0.0",
    "eslint-plugin-import": "^2.32.0",
    "husky": "^9.1.7",
    "jest": "^29.7.0",
    "jest-expo": "54.0.18",
    "lint-staged": "^17.3.0",
    "oxlint": "1.88.0",
    "prettier": "^3.9.6",
    "prettier-plugin-tailwindcss": "^0.8.1",
    "typescript": "~5.9.2"
  },
  "private": true,
  "lint-staged": {
    "*.{js,mjs,ts,tsx}": [
      "prettier --write",
      "eslint --fix"
    ],
    "*.{json,yml,yaml}": [
      "prettier --write"
    ]
  }
}
