# HouseGains Admin web app — local configuration.
# Copy this file to .env and fill in the Firebase web app config.
# NEVER commit real keys or a filled .env file.

VITE_FIREBASE_API_KEY=
VITE_FIREBASE_AUTH_DOMAIN=
VITE_FIREBASE_PROJECT_ID=
VITE_FIREBASE_APP_ID=

# Set to 1 to point Firebase Auth and Functions at the local emulators
# (Auth on http://localhost:9099, Functions on localhost:5001).
VITE_USE_EMULATORS=0
