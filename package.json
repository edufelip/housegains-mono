{
  "name": "housegains-mono",
  "private": true,
  "packageManager": "bun@1.3.14",
  "engines": {
    "bun": "1.3.14"
  },
  "workspaces": [
    "apps/*"
  ],
  "scripts": {
    "setup": "bash scripts/setup.sh",
    "local:bun:install": "bash scripts/install-pinned-bun.sh",
    "mobile:start": "cd apps/mobile && bunx expo start",
    "mobile:android": "cd apps/mobile && bunx expo run:android",
    "mobile:ios": "cd apps/mobile && bunx expo run:ios",
    "firebase:emulators": "cd apps/firebase && npx -y firebase-tools@14 emulators:start"
  }
}
